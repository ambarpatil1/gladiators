    </validationRules>
    <validationRules>
        <fullName>LeadValidationRule2</fullName>
        <active>true</active>
        <errorConditionFormula>City   &lt;&gt;  &quot;Hyderabad&quot;</errorConditionFormula>
        <errorMessage>Not a valid City</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VL3</fullName>
        <active>false</active>
        <description>12345678974108520963</description>
