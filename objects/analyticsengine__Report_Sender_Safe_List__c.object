<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>List</customSettingsType>
    <description>Domain names which are safe for sending reports/dashboards via CloudAnswers Report Sender</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>analyticsengine__Domain_Name__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>Enter a domain domain e.g. cloudanswers.com</inlineHelpText>
        <label>Domain Name</label>
        <length>255</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Report Sender Safe List</label>
    <visibility>Public</visibility>
</CustomObject>